# ============================================
# FRONTEND (Vercel Environment Variables)
# ============================================

# Backend API URL — set this to your deployed Render backend URL
# Local:      http://localhost:5000/api
# Production: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Cloudinary cloud name for image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# (Optional) Frontend URL for SEO sitemap/robots.txt
NEXT_PUBLIC_FRONTEND_URL=https://your-app.vercel.app

# ============================================
# BACKEND (Render Environment Variables)
# ============================================

PORT=5000

# Set to 'production' on Render for secure cookies & optimized performance
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/laforet?retryWrites=true&w=majority

# JWT signing secret (min 64 characters, generate with: openssl rand -hex 64)
JWT_SECRET=generate_a_secure_random_string_min_64_chars

# Frontend URL for CORS & CSP headers
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# ============================================
# CLOUDINARY (Used by Backend)
# ============================================

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
